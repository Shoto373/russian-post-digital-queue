# Режим: development | production
APP_ENV=development
LOG_LEVEL=INFO
HTTP_PORT=8080
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=postcode
POSTGRES_USER=postcode
# ⚠️ ОБЯЗАТЕЛЬНО смените пароль для продакшена (например через: openssl rand -base64 24)
POSTGRES_PASSWORD=local-development-only
# Разрешенные источники CORS через запятую (без wildcards и путей)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
CORS_ALLOWED_ORIGIN=http://localhost:5173
# Оставьте пустым для работы через обратный прокси (Vite / Nginx) без CORS и проблем с cookie
VITE_API_BASE_URL=
FRONTEND_PORT=5173
GRAFANA_USER=admin
# ⚠️ ОБЯЗАТЕЛЬНО смените пароль для продакшена
GRAFANA_PASSWORD=admin
SERVER_DOMAIN=post-queue.duckdns.org
TZ=Europe/Moscow
# Alertmanager Telegram Notifications (Опционально)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
